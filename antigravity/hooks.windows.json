{
  "kenaido-guardrail": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "kenaido-guardrail-self-test": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 15
      }
    ]
  }
}
