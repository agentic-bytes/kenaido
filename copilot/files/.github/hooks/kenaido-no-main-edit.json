{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "if ! command -v git >/dev/null 2>&1; then echo 'kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: git was not found, so it cannot tell which branch is checked out. Install git, or put it on PATH.' >&2; exit 2; fi; [ -r \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.github/kenaido/no-main-edit.sh\" ] || { echo 'kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: its script in .github/kenaido/ is missing. Install the kenaido Copilot package into this project again.' >&2; exit 2; }",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
        "cwd": "."
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "create|edit|str_replace_editor|apply_patch|bash|powershell|write_bash|write_powershell|.*-.*",
        "bash": "p=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.github/kenaido/no-main-edit.sh\"; if [ -r \"$p\" ]; then sh \"$p\" 2>/dev/null || true; else printf '%s\\n' '{\"type\": \"progress\", \"message\": \"kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: its script in .github/kenaido/ is missing. Install the kenaido Copilot package into this project again.\"}'; fi",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
        "cwd": "."
      }
    ]
  }
}
