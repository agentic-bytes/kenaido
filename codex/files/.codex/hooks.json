{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "export LC_ALL=C; i=$(cat 2>/dev/null); d=; a=; f=$(printf '%s' \"$i\" | tr '\\n\\r\\t' '   ' | sed 's/\"[[:space:]]*:[[:space:]]*/\":/g'); case \"$f\" in *'\"cwd\":'*) r=${f#*'\"cwd\":'}; case \"$r\" in *'\"cwd\":'*) a=1;; '\"'*) r=${r#?}; d=${r%%'\"'*}; [ -n \"$d\" ] || a=1;; *) a=1;; esac;; esac; case \"$d\" in *'\\'*) a=1;; /*) ;; '') ;; *) a=1;; esac; [ -z \"$a\" ] || d=; [ -n \"$d\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null); [ -n \"$d\" ] || d=.; p=\"$d/.codex/kenaido/no-main-edit.sh\"; h=; [ -r \"$p\" ] && h=$( (sha256sum || shasum -a 256) < \"$p\" 2>/dev/null); h=${h%% *}; if ! command -v git >/dev/null 2>&1; then printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: git was not found, so it cannot tell which branch is checked out. Install git, or put it on PATH.\"}'; elif [ ! -r \"$p\" ]; then printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: its script in .codex/kenaido/ is missing. Install the kenaido Codex package into this project again.\"}'; elif [ \"$h\" != 5b266940d9aa7921dd43b43d93a0d7af4df44da86b91845e50921e6462abe3c3 ]; then printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail script in .codex/kenaido/ is not the one installed with the hooks you trusted (its checksum does not match, or could not be computed), so it was not run. On main or master every edit, shell command and MCP tool call is refused until you install the kenaido Codex package into this project again. If the script was changed on purpose, have a person review that change first.\"}'; fi",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:apply_patch|Edit|Write|Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "export LC_ALL=C; i=$(cat 2>/dev/null); d=; a=; f=$(printf '%s' \"$i\" | tr '\\n\\r\\t' '   ' | sed 's/\"[[:space:]]*:[[:space:]]*/\":/g'); case \"$f\" in *'\"cwd\":'*) r=${f#*'\"cwd\":'}; case \"$r\" in *'\"cwd\":'*) a=1;; '\"'*) r=${r#?}; d=${r%%'\"'*}; [ -n \"$d\" ] || a=1;; *) a=1;; esac;; esac; case \"$d\" in *'\\'*) a=1;; /*) ;; '') ;; *) a=1;; esac; [ -z \"$a\" ] || d=; [ -n \"$d\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null); [ -n \"$d\" ] || d=.; p=\"$d/.codex/kenaido/no-main-edit.sh\"; h=; [ -r \"$p\" ] && h=$( (sha256sum || shasum -a 256) < \"$p\" 2>/dev/null); h=${h%% *}; if [ ! -r \"$p\" ] && [ -n \"$a\" ]; then printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: the hook input names the project folder (cwd) in a way it cannot read with certainty, and the folder Codex started it in holds no kenaido guardrail either.\"}'; elif [ ! -r \"$p\" ]; then printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail that refuses edits, shell commands and MCP tool calls on main or master cannot run, so none of them are being refused there. Reason: its script in .codex/kenaido/ is missing. Install the kenaido Codex package into this project again.\"}'; elif [ \"$h\" = 5b266940d9aa7921dd43b43d93a0d7af4df44da86b91845e50921e6462abe3c3 ]; then sh \"$p\" \"$i\" 2>/dev/null || true; else case \"$(git -C \"$d\" rev-parse --abbrev-ref HEAD 2>/dev/null)\" in main|master) printf '%s\\n' '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"kenaido GIT-1: main or master is checked out, and the guardrail script in .codex/kenaido/ is not the one installed with the hooks you trusted (its checksum does not match, or could not be computed), so this action is refused. Install the kenaido Codex package into this project again. If the script was changed on purpose, have a person review that change first.\"}}';; *) printf '%s\\n' '{\"systemMessage\": \"kenaido warning: the guardrail script in .codex/kenaido/ is not the one installed with the hooks you trusted (its checksum does not match, or could not be computed), so it was not run. On main or master every edit, shell command and MCP tool call is refused until you install the kenaido Codex package into this project again. If the script was changed on purpose, have a person review that change first.\"}';; esac; fi",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
